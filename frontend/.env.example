# Supabase — copy this to .env and fill in your project values
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Backend API URL
VITE_API_URL=http://localhost:3000

# Offline-first layer (local cache, outbox, PWA). See frontend/src/offline/.
VITE_OFFLINE_ENABLED=true

# Pre-launch /masuk gate (see src/pages/LoginOrRegister.jsx)
# Demo password → mockup data, no login. Real password → login + live data.
# Production builds default the real password to real_data_hyro.
VITE_GATE_PASSWORD_DEMO=arisan-patungan-2026
GATE_PASSWORD_REAL=real_data_hyro
