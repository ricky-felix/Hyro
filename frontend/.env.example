# Supabase — copy this to .env and fill in your project values
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Backend API URL
VITE_API_URL=http://localhost:3000

# Offline-first layer (local cache, outbox, PWA). See frontend/src/offline/.
VITE_OFFLINE_ENABLED=true
